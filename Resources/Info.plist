<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>ClipGum</string>
    <key>CFBundleIdentifier</key>
    <string>com.clipgum.ClipGum</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>ClipGum</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>

    <!-- Public release metadata is injected into the built copy only. Blank
         development values fail closed and UpdateManager does not start. -->
    <key>SUFeedURL</key>
    <string></string>
    <key>SUPublicEDKey</key>
    <string></string>
    <key>SURequireSignedFeed</key>
    <true/>
    <key>SUVerifyUpdateBeforeExtraction</key>
    <true/>
    <key>SUEnableInstallerLauncherService</key>
    <true/>
    <key>SUEnableDownloaderService</key>
    <false/>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUAllowsAutomaticUpdates</key>
    <false/>
    <key>SUAutomaticallyUpdate</key>
    <false/>
    <key>SUPromptUserOnFirstLaunch</key>
    <false/>
    <key>SUEnableSystemProfiling</key>
    <false/>
    <key>SUSendProfileInfo</key>
    <false/>
    <key>SUEnableJavaScript</key>
    <false/>
    <key>SUAllowedURLSchemes</key>
    <array>
        <string>https</string>
    </array>

    <key>NSLocalNetworkUsageDescription</key>
    <string>ClipGum uses Bonjour only for an explicitly started, one-time local device handoff.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_clipgum._tcp</string>
    </array>

    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.clipgum.ClipGum.deep-link</string>
            <key>CFBundleURLSchemes</key>
            <array><string>clipgum</string></array>
        </dict>
    </array>
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Clean &amp; Paste with ClipGum</string>
            </dict>
            <key>NSMessage</key>
            <string>cleanAndPasteWithClipGum</string>
            <key>NSSendTypes</key>
            <array><string>public.utf8-plain-text</string></array>
            <key>NSReturnTypes</key>
            <array><string>public.utf8-plain-text</string></array>
        </dict>
    </array>
</dict>
</plist>
